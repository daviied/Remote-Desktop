# Copy to .env and edit. Never commit .env.

# ---- Coordinator (Tailscale mode only) ----
# Public HTTPS URL of the coordinator (your nginx reverse proxy).
HEADSCALE_SERVER_URL=https://rd.example.com
# Public IPv4 of the server (used by the relay for STUN).
HEADSCALE_DERP_SERVER_IPV4=203.0.113.10
# Data folder on the Docker host.
DATA_DIR=./data

# ---- Power (smart outlet) ----
# Long random string. Clients and the host use it to call /power/. Make one: openssl rand -hex 24
RD_POWER_TOKEN=change-me-to-a-long-random-string
# How rd-power sees if the host is on. Set ONE:
# WireGuard mode: host LAN IP (fixed). The server must reach it (TCP 47989).
HOST_ADDR=192.168.1.20
# Tailscale mode: headscale API key (docker exec rd-coordinator headscale apikeys create --expiration 3650d)
HEADSCALE_API_KEY=
HOST_NODE=rd-host
# Seconds to wait after the host goes offline before cutting power
OFF_GRACE_SECONDS=60

# Pick one backend: homeassistant | tuya-local | tuya-cloud
POWER_BACKEND=homeassistant

# Home Assistant (long-lived access token: HA profile -> Security)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
HA_ENTITY=switch.pc_outlet

# Tuya local (same LAN as the server; get id/key with: python -m tinytuya wizard)
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_IP=192.168.1.50
TUYA_VERSION=3.3
TUYA_SWITCH_DPS=1

# Tuya cloud (iot.tuya.com project)
TUYA_REGION=us
TUYA_API_KEY=
TUYA_API_SECRET=
TUYA_SWITCH_CODE=switch_1
