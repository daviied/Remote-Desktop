+void Session::clRdSetCursorShape(uint32_t id, uint16_t width, uint16_t height, uint16_t hotX, uint16_t hotY, const uint8_t* bgra)
+{
+    // Called on the control stream thread: copy and hand off to the main thread.
+    auto shape = new RdCursorShapeEvent { id, width, height, hotX, hotY,
+                                          QByteArray((const char*)bgra, (int)width * height * 4) };
+    SDL_Event event = {};
+    event.type = SDL_USEREVENT;
+    event.user.code = SDL_CODE_RD_CURSOR_SHAPE;
+    event.user.data1 = shape;
+    if (SDL_PushEvent(&event) <= 0) {
+        delete shape;
+    }
+}
+
+void Session::clRdSetCursorState(uint32_t id, bool visible)
+{
+    SDL_Event event = {};
+    event.type = SDL_USEREVENT;
+    event.user.code = SDL_CODE_RD_CURSOR_STATE;
+    event.user.data1 = (void*)(uintptr_t)id;
+    event.user.data2 = (void*)(uintptr_t)(visible ? 1 : 0);
+    SDL_PushEvent(&event);
+}
