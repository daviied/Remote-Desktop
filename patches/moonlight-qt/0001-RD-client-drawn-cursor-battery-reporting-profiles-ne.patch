+Uint32 Session::rdBatteryTimerCallback(Uint32 interval, void*)
+{
+    // Runs on SDL's timer thread. Report client battery to the host tray.
+    static int lastPercent = -2;
+    static uint8_t lastFlags = 0xFF;
+    static Uint32 lastSent = 0;
+    static const QByteArray deviceName = QSysInfo::machineHostName().left(64).toUtf8();
+
+    int secs = -1, pct = -1;
+    SDL_PowerState state = SDL_GetPowerInfo(&secs, &pct);
+    uint8_t flags = 0;
+    switch (state) {
+    case SDL_POWERSTATE_ON_BATTERY: flags = RD_BATT_DISCHARGING; break;
+    case SDL_POWERSTATE_CHARGING: flags = RD_BATT_CHARGING; break;
+    case SDL_POWERSTATE_NO_BATTERY: flags = RD_BATT_NO_BATTERY; break;
+    default: break;
+    }
+
+    Uint32 now = SDL_GetTicks();
+    if (pct != lastPercent || flags != lastFlags || now - lastSent > 120000) {
+        uint16_t minutes = secs >= 0 ? (uint16_t)qMin(secs / 60, 0xFFFE) : 0xFFFF;
+        if (LiRdSendBatteryStatus(pct >= 0 ? (uint8_t)pct : 255, flags, minutes, deviceName.constData()) == 0) {
+            lastPercent = pct;
+            lastFlags = flags;
+            lastSent = now;
+        }
+    }
+    return interval;
+}
