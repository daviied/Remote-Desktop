diff --git a/app/rd/rdprofiles.cpp b/app/rd/rdprofiles.cpp
new file mode 100644
index 0000000..54cd213
--- /dev/null
+++ b/app/rd/rdprofiles.cpp
@@ -0,0 +1,394 @@
+// RD extension: per-device connection profiles, network rules, multi-monitor launch.
+#include "rdprofiles.h"
+
+#include "settings/streamingpreferences.h"
+#include "backend/nvcomputer.h"
+
+#include <QCoreApplication>
+#include <QJsonDocument>
+#include <QRegularExpression>
+#include <QSettings>
+#include <QSysInfo>
+
+#if QT_VERSION >= QT_VERSION_CHECK(6, 3, 0)
+#include <QNetworkInformation>
+#endif
+
+#define RD_SETTINGS_KEY "rd/config"
+#define RD_BASE_PORT 47989
+#define RD_PORT_STEP 100
+
+QString RdProfiles::s_CliProfile;
+int RdProfiles::s_CliMonitor = -1;
+
+RdProfiles* RdProfiles::get()
+{
+    static RdProfiles* s_Instance = new RdProfiles(QCoreApplication::instance());
+    return s_Instance;
+}
+
+RdProfiles::RdProfiles(QObject* parent) : QObject(parent)
+{
+    load();
+}
+
+void RdProfiles::load()
+{
+    QSettings settings;
+    QVariantMap root = QJsonDocument::fromJson(settings.value(RD_SETTINGS_KEY).toByteArray()).toVariant().toMap();
+    m_Profiles = root.value("profiles").toList();
+    m_Rules = root.value("rules").toList();
+    m_DefaultProfile = root.value("defaultProfile").toString();
+
+    if (m_Profiles.isEmpty()) {
+        // First run: one profile matching a single native-resolution monitor.
+        m_Profiles.append(newProfile(QSysInfo::machineHostName().isEmpty() ? "Default" : QSysInfo::machineHostName()));
+        m_DefaultProfile = m_Profiles.first().toMap().value("name").toString();
+    }
+}
+
+void RdProfiles::save()
+{
+    QVariantMap root;
+    root["profiles"] = m_Profiles;
+    root["rules"] = m_Rules;
+    root["defaultProfile"] = m_DefaultProfile;
+    QSettings settings;
+    settings.setValue(RD_SETTINGS_KEY, QJsonDocument::fromVariant(root).toJson(QJsonDocument::Compact));
+}
+
+void RdProfiles::setProfiles(const QVariantList& p) { m_Profiles = p; emit changed(); }
+void RdProfiles::setRules(const QVariantList& r) { m_Rules = r; emit changed(); }
+void RdProfiles::setDefaultProfile(const QString& n) { m_DefaultProfile = n; emit changed(); }
+void RdProfiles::setSessionProfile(const QString& n) { m_SessionProfile = n; emit changed(); }
+
+QStringList RdProfiles::profileNames() const
+{
+    QStringList names;
+    for (const QVariant& v : m_Profiles) {
+        names.append(v.toMap().value("name").toString());
+    }
+    return names;
+}
+
+QVariantMap RdProfiles::newProfile(const QString& name) const
+{
+    QVariantMap monitor;
+    monitor["width"] = 1920;
+    monitor["height"] = 1080;
+    monitor["fps"] = 60;
+    monitor["port"] = RD_BASE_PORT;
+    monitor["clientDisplay"] = 0;
+
+    QVariantMap p;
+    p["name"] = name;
+    p["bitrateKbps"] = 0;           // 0 = Moonlight default for the resolution/fps
+    p["codec"] = "auto";
+    p["hdr"] = false;
+    p["localCursor"] = true;
+    p["windowMode"] = "fullscreen";
+    p["monitors"] = QVariantList { monitor };
+    return p;
+}
+
+QVariantMap RdProfiles::newRule(const QString& name) const
+{
+    QVariantMap r;
+    r["name"] = name;
+    r["match"] = "wifi";
+    r["ssids"] = QStringList();
+    r["profile"] = "";
+    r["bitrateKbps"] = 0;
+    r["maxFps"] = 0;
+    r["maxHeight"] = 0;
+    r["codec"] = "";
+    return r;
+}
+
+QVariantMap RdProfiles::findProfile(const QString& name) const
+{
+    for (const QVariant& v : m_Profiles) {
+        if (v.toMap().value("name").toString() == name) {
+            return v.toMap();
+        }
+    }
+    return m_Profiles.isEmpty() ? QVariantMap() : m_Profiles.first().toMap();
+}
+
+void RdProfiles::setCliSelection(const QString& profile, int monitorIndex)
+{
+    s_CliProfile = profile;
+    s_CliMonitor = monitorIndex;
+}
+
+int RdProfiles::cliMonitorIndex()
+{
+    return s_CliMonitor;
+}
+
+static QString runAndRead(const QString& program, const QStringList& args)
+{
+    QProcess p;
+    p.start(program, args);
+    if (!p.waitForFinished(1500)) {
+        p.kill();
+        return QString();
+    }
+    return QString::fromLocal8Bit(p.readAllStandardOutput());
+}
+
+static QString detectSsid()
+{
+#if defined(Q_OS_WIN)
+    // Windows 11 24H2+: needs Location services on for the SSID to be visible.
+    QString out = runAndRead("netsh", { "wlan", "show", "interfaces" });
+    static QRegularExpression re("^\\s*SSID\\s*:\\s*(.+?)\\s*$", QRegularExpression::MultilineOption);
+    auto m = re.match(out);
+    return m.hasMatch() ? m.captured(1) : QString();
+#elif defined(Q_OS_MACOS)
+    // macOS 14+ redacts the SSID unless the app has Location permission.
+    QString out = runAndRead("/usr/sbin/ipconfig", { "getsummary", "en0" });
+    static QRegularExpression re("^\\s*SSID\\s*:\\s*(.+?)\\s*$", QRegularExpression::MultilineOption);
+    auto m = re.match(out);
+    QString ssid = m.hasMatch() ? m.captured(1) : QString();
+    return ssid == "<redacted>" ? QString() : ssid;
+#elif defined(Q_OS_LINUX)
+    QString out = runAndRead("nmcli", { "-t", "-f", "active,ssid", "dev", "wifi" });
+    for (const QString& line : out.split('\n')) {
+        if (line.startsWith("yes:")) {
+            return line.mid(4).replace("\\:", ":");
+        }
+    }
+    return QString();
+#else
+    return QString();
+#endif
+}
+
+RdNetworkInfo RdProfiles::detectNetwork()
+{
+    RdNetworkInfo info;
+    info.medium = "unknown";
+
+#if QT_VERSION >= QT_VERSION_CHECK(6, 3, 0)
+    if (!QNetworkInformation::instance()) {
+        QNetworkInformation::loadBackendByFeatures(QNetworkInformation::Feature::TransportMedium |
+                                                   QNetworkInformation::Feature::Metered);
+    }
+    if (auto ni = QNetworkInformation::instance()) {
+        switch (ni->transportMedium()) {
+        case QNetworkInformation::TransportMedium::Ethernet: info.medium = "ethernet"; break;
+        case QNetworkInformation::TransportMedium::WiFi: info.medium = "wifi"; break;
+        case QNetworkInformation::TransportMedium::Cellular: info.medium = "cellular"; break;
+        case QNetworkInformation::TransportMedium::Bluetooth: info.medium = "bluetooth"; break;
+        default: break;
+        }
+        if (ni->supports(QNetworkInformation::Feature::Metered)) {
+            info.metered = ni->isMetered();
+        }
+    }
+#endif
+
+    info.ssid = detectSsid();
+    if (info.medium == "unknown" && !info.ssid.isEmpty()) {
+        info.medium = "wifi";
+    }
+    return info;
+}
+
+static bool ssidMatches(const QString& ssid, const QStringList& patterns)
+{
+    for (const QString& pat : patterns) {
+        if (pat.trimmed().isEmpty()) {
+            continue;
+        }
+        QRegularExpression re(QRegularExpression::wildcardToRegularExpression(pat.trimmed()),
+                              QRegularExpression::CaseInsensitiveOption);
+        if (re.match(ssid).hasMatch()) {
+            return true;
+        }
+    }
+    return false;
+}
+
+QVariantMap RdProfiles::matchRule(const RdNetworkInfo& net) const
+{
+    for (const QVariant& v : m_Rules) {
+        QVariantMap r = v.toMap();
+        QString match = r.value("match").toString();
+        QStringList ssids = r.value("ssids").toStringList();
+        ssids.removeAll(QString());
+
+        bool typeOk;
+        if (match == "any") {
+            typeOk = true;
+        }
+        else if (match == "tethered") {
+            // Hotspot / USB / Bluetooth tethering: OS-reported metered, cellular or Bluetooth link,
+            // or a Wi-Fi SSID from this rule's list.
+            typeOk = net.metered || net.medium == "cellular" || net.medium == "bluetooth" ||
+                     (!ssids.isEmpty() && ssidMatches(net.ssid, ssids));
+        }
+        else {
+            typeOk = (match == net.medium);
+        }
+        if (!typeOk) {
+            continue;
+        }
+        if (match != "tethered" && !ssids.isEmpty() && !ssidMatches(net.ssid, ssids)) {
+            continue;
+        }
+        return r;
+    }
+    return QVariantMap();
+}
+
+QString RdProfiles::describeNetwork()
+{
+    RdNetworkInfo net = detectNetwork();
+    QVariantMap rule = matchRule(net);
+    QString s = tr("Network: %1").arg(net.medium);
+    if (!net.ssid.isEmpty()) s += QString(" \"%1\"").arg(net.ssid);
+    if (net.metered) s += tr(" (metered)");
+    s += tr(" — rule: %1").arg(rule.isEmpty() ? tr("none") : rule.value("name").toString());
+    return s;
+}
+
+static StreamingPreferences::VideoCodecConfig codecFromString(const QString& c, StreamingPreferences::VideoCodecConfig fallback)
+{
+    if (c == "auto") return StreamingPreferences::VCC_AUTO;
+    if (c == "h264") return StreamingPreferences::VCC_FORCE_H264;
+    if (c == "hevc") return StreamingPreferences::VCC_FORCE_HEVC;
+    if (c == "av1") return StreamingPreferences::VCC_FORCE_AV1;
+    return fallback;
+}
+
+StreamingPreferences* RdProfiles::prepare(StreamingPreferences* cliPrefs, QObject* parent)
+{
+    int monitorIndex = 0;
+    QString profileName;
+
+    if (cliPrefs) {
+        if (s_CliMonitor < 0) {
+            // Plain CLI stream: leave the user's command-line settings alone.
+            m_ActiveProfile.clear();
+            m_ActiveLocalCursor = true;
+            m_ActiveClientDisplay = -1;
+            return cliPrefs;
+        }
+        monitorIndex = s_CliMonitor;
+        profileName = s_CliProfile;
+    }
+    else {
+        profileName = m_SessionProfile.isEmpty() ? m_DefaultProfile : m_SessionProfile;
+        // The chooser applies to one connection only.
+        m_SessionProfile.clear();
+        emit changed();
+    }
+
+    // Network rule can switch to another profile and cap values.
+    RdNetworkInfo net = detectNetwork();
+    QVariantMap rule = matchRule(net);
+    if (!rule.value("profile").toString().isEmpty() && s_CliMonitor < 0) {
+        profileName = rule.value("profile").toString();
+    }
+
+    m_ActiveProfile = findProfile(profileName);
+
+    StreamingPreferences* prefs = cliPrefs ? cliPrefs : StreamingPreferences::createDetached(parent);
+    if (m_ActiveProfile.isEmpty()) {
+        return prefs;
+    }
+
+    QVariantList monitors = m_ActiveProfile.value("monitors").toList();
+    QVariantMap mon = monitorIndex < monitors.size() ? monitors.at(monitorIndex).toMap() : QVariantMap();
+
+    if (mon.value("width").toInt() > 0 && mon.value("height").toInt() > 0) {
+        prefs->width = mon.value("width").toInt();
+        prefs->height = mon.value("height").toInt();
+    }
+    if (mon.value("fps").toInt() > 0) {
+        prefs->fps = mon.value("fps").toInt();
+    }
+    prefs->bitrateKbps = m_ActiveProfile.value("bitrateKbps").toInt() > 0
+            ? m_ActiveProfile.value("bitrateKbps").toInt()
+            : StreamingPreferences::getDefaultBitrate(prefs->width, prefs->height, prefs->fps, prefs->enableYUV444);
+    prefs->videoCodecConfig = codecFromString(m_ActiveProfile.value("codec").toString(), prefs->videoCodecConfig);
+    prefs->enableHdr = m_ActiveProfile.value("hdr").toBool();
+
+    QString wm = m_ActiveProfile.value("windowMode").toString();
+    if (wm == "fullscreen") prefs->windowMode = StreamingPreferences::WM_FULLSCREEN;
+    else if (wm == "borderless") prefs->windowMode = StreamingPreferences::WM_FULLSCREEN_DESKTOP;
+    else if (wm == "windowed") prefs->windowMode = StreamingPreferences::WM_WINDOWED;
+
+    m_ActiveLocalCursor = m_ActiveProfile.value("localCursor", true).toBool();
+    if (m_ActiveLocalCursor) {
+        // Client-drawn cursor needs absolute (desktop) mouse mode.
+        prefs->absoluteMouseMode = true;
+    }
+    m_ActiveClientDisplay = mon.contains("clientDisplay") ? mon.value("clientDisplay").toInt() : monitorIndex;
+
+    // Network rule caps
+    if (!rule.isEmpty()) {
+        int maxH = rule.value("maxHeight").toInt();
+        if (maxH > 0 && prefs->height > maxH) {
+            prefs->width = ((prefs->width * maxH / prefs->height) + 1) & ~1;
+            prefs->height = maxH;
+        }
+        int maxFps = rule.value("maxFps").toInt();
+        if (maxFps > 0 && prefs->fps > maxFps) {
+            prefs->fps = maxFps;
+        }
+        int br = rule.value("bitrateKbps").toInt();
+        if (br > 0) {
+            // Split the rule's bitrate across monitors
+            prefs->bitrateKbps = qMax(1000, br / qMax(1, (int)monitors.size()));
+        }
+        prefs->videoCodecConfig = codecFromString(rule.value("codec").toString(), prefs->videoCodecConfig);
+    }
+
+    return prefs;
+}
+
+void RdProfiles::launchSecondaryMonitors(NvComputer* computer, const QString& appName)
+{
+    stopSecondaryMonitors();
+    if (s_CliMonitor > 0 || m_ActiveProfile.isEmpty() || computer == nullptr) {
+        // Secondary processes never spawn more processes.
+        return;
+    }
+
+    QVariantList monitors = m_ActiveProfile.value("monitors").toList();
+    QString host = computer->activeAddress.address();
+    if (host.isEmpty()) {
+        host = computer->name;
+    }
+
+    for (int i = 1; i < monitors.size(); i++) {
+        QVariantMap mon = monitors.at(i).toMap();
+        int port = mon.value("port").toInt() > 0 ? mon.value("port").toInt() : RD_BASE_PORT + RD_PORT_STEP * i;
+        QString target = host.contains(':') ? QString("[%1]:%2").arg(host).arg(port) : QString("%1:%2").arg(host).arg(port);
+
+        auto proc = new QProcess(this);
+        proc->setProgram(QCoreApplication::applicationFilePath());
+        proc->setArguments({ "stream", target, appName,
+                             "--rd-profile", m_ActiveProfile.value("name").toString(),
+                             "--rd-monitor", QString::number(i) });
+        connect(proc, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished), proc, &QObject::deleteLater);
+        proc->start();
+        m_Secondaries.append(proc);
+    }
+}
+
+void RdProfiles::stopSecondaryMonitors()
+{
+    for (auto& p : m_Secondaries) {
+        if (p && p->state() != QProcess::NotRunning) {
+            p->terminate();
+            if (!p->waitForFinished(3000)) {
+                p->kill();
+            }
+        }
+    }
+    m_Secondaries.clear();
+}
