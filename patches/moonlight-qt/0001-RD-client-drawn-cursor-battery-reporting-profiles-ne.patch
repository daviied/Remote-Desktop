diff --git a/app/streaming/input/rdcursor.cpp b/app/streaming/input/rdcursor.cpp
new file mode 100644
index 0000000..a3657fe
--- /dev/null
+++ b/app/streaming/input/rdcursor.cpp
@@ -0,0 +1,162 @@
+// RD extension: client-drawn cursor (Parsec-style).
+// The host stops drawing the cursor into the video and sends its shape instead.
+// We show it as the OS cursor, so it moves at local refresh rate with zero network delay.
+#include "input.h"
+#include "streaming/streamutils.h"
+
+#include <cmath>
+
+// Host cursor hidden this long (ms) = an app captured the mouse (e.g. a game):
+// switch to relative mode. Shorter gaps (hide-while-typing) keep absolute mode.
+#define RD_HIDDEN_TO_RELATIVE_MS 400
+
+void SdlInputHandler::rdEnableLocalCursor()
+{
+    m_RdLocalCursor = true;
+    m_AbsoluteMouseMode = true;
+    m_MouseCursorCapturedVisibilityState = SDL_ENABLE;
+    if (isCaptureActive()) {
+        SDL_ShowCursor(SDL_ENABLE);
+    }
+    rdApplyCursor();
+}
+
+float SdlInputHandler::rdCursorScale()
+{
+    if (m_Window == nullptr || m_StreamWidth <= 0 || m_StreamHeight <= 0) {
+        return 1.0f;
+    }
+
+    // Cursor pixels are host pixels. Scale them like the video, in window coordinates
+    // (points on macOS, so Retina displays get the right physical size).
+    int windowWidth, windowHeight;
+    SDL_GetWindowSize(m_Window, &windowWidth, &windowHeight);
+
+    SDL_Rect src = { 0, 0, m_StreamWidth, m_StreamHeight };
+    SDL_Rect dst = { 0, 0, windowWidth, windowHeight };
+    StreamUtils::scaleSourceToDestinationSurface(&src, &dst);
+
+    float scale = (float)dst.w / (float)m_StreamWidth;
+    return scale > 0 ? scale : 1.0f;
+}
+
+void SdlInputHandler::rdApplyCursor()
+{
+    if (!m_RdLocalCursor || m_RdCurrentId == 0 || !m_RdShapes.contains(m_RdCurrentId)) {
+        return;
+    }
+
+    float scale = rdCursorScale();
+    if (m_RdCursor != nullptr && m_RdAppliedId == m_RdCurrentId && std::fabs(scale - m_RdAppliedScale) < 0.01f) {
+        return;
+    }
+
+    const RdCursorShape& shape = m_RdShapes[m_RdCurrentId];
+    SDL_Surface* src = SDL_CreateRGBSurfaceWithFormatFrom((void*)shape.bgra.constData(),
+                                                          shape.width, shape.height, 32, shape.width * 4,
+                                                          SDL_PIXELFORMAT_ARGB8888);
+    if (src == nullptr) {
+        return;
+    }
+
+    int w = qMax(1, (int)std::lround(shape.width * scale));
+    int h = qMax(1, (int)std::lround(shape.height * scale));
+    SDL_Surface* surface = src;
+    if (w != shape.width || h != shape.height) {
+        surface = SDL_CreateRGBSurfaceWithFormat(0, w, h, 32, SDL_PIXELFORMAT_ARGB8888);
+        if (surface != nullptr) {
+            SDL_SetSurfaceBlendMode(src, SDL_BLENDMODE_NONE);
+            SDL_Rect dstRect = { 0, 0, w, h };
+            SDL_BlitScaled(src, nullptr, surface, &dstRect);
+        }
+        else {
+            surface = src;
+            w = shape.width;
+            h = shape.height;
+        }
+    }
+
+    float sx = (float)w / shape.width;
+    float sy = (float)h / shape.height;
+    SDL_Cursor* cursor = SDL_CreateColorCursor(surface,
+                                               qBound(0, (int)(shape.hotX * sx), w - 1),
+                                               qBound(0, (int)(shape.hotY * sy), h - 1));
+    if (surface != src) {
+        SDL_FreeSurface(surface);
+    }
+    SDL_FreeSurface(src);
+
+    if (cursor != nullptr) {
+        SDL_SetCursor(cursor);
+        if (m_RdCursor != nullptr) {
+            SDL_FreeCursor(m_RdCursor);
+        }
+        m_RdCursor = cursor;
+        m_RdAppliedId = m_RdCurrentId;
+        m_RdAppliedScale = scale;
+    }
+}
+
+void SdlInputHandler::rdSetCursorShape(uint32_t id, int width, int height, int hotX, int hotY, const QByteArray& bgra)
+{
+    // Keep a small cache; hosts reuse a handful of shapes.
+    if (m_RdShapes.size() > 64) {
+        m_RdShapes.clear();
+    }
+    m_RdShapes.insert(id, RdCursorShape { width, height, hotX, hotY, bgra });
+    m_RdCurrentId = id;
+    rdApplyCursor();
+}
+
+void SdlInputHandler::rdSetCursorState(uint32_t id, bool visible)
+{
+    if (id != 0 && id != m_RdCurrentId) {
+        m_RdCurrentId = id;
+        rdApplyCursor();
+    }
+
+    if (visible == m_RdHostVisible) {
+        return;
+    }
+    m_RdHostVisible = visible;
+
+    if (!visible) {
+        // Hide right away; decide about relative mode on the next mouse motion.
+        m_RdHiddenSince = SDL_GetTicks();
+        m_MouseCursorCapturedVisibilityState = SDL_DISABLE;
+        if (isCaptureActive() && m_AbsoluteMouseMode) {
+            SDL_ShowCursor(SDL_DISABLE);
+        }
+    }
+    else {
+        m_RdHiddenSince = 0;
+        m_MouseCursorCapturedVisibilityState = SDL_ENABLE;
+        rdUpdateMode();
+        if (isCaptureActive()) {
+            SDL_ShowCursor(SDL_ENABLE);
+        }
+    }
+}
+
+void SdlInputHandler::rdUpdateMode()
+{
+    bool wantAbsolute = m_RdHostVisible ||
+            (m_RdHiddenSince != 0 && SDL_GetTicks() - m_RdHiddenSince < RD_HIDDEN_TO_RELATIVE_MS);
+
+    if (wantAbsolute != m_AbsoluteMouseMode) {
+        bool active = isCaptureActive();
+        if (active) {
+            setCaptureActive(false);
+        }
+        m_AbsoluteMouseMode = wantAbsolute;
+        if (active) {
+            // Re-capturing in absolute mode also syncs the host cursor to the local position.
+            setCaptureActive(true);
+        }
+    }
+
+    if (m_AbsoluteMouseMode) {
+        // Window may have been resized or moved to another display
+        rdApplyCursor();
+    }
+}
