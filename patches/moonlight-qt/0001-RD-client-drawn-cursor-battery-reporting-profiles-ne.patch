+// RD extension: per-device connection profiles, network rules, multi-monitor launch.
+#pragma once
+
+#include <QObject>
+#include <QVariantList>
+#include <QProcess>
+#include <QList>
+#include <QPointer>
+
+class StreamingPreferences;
+class NvComputer;
+
+struct RdNetworkInfo {
+    QString medium;   // "ethernet", "wifi", "cellular", "bluetooth", "unknown"
+    bool metered = false;
+    QString ssid;     // empty if unknown / not Wi-Fi
+};
+
+/*
+ * Stored in QSettings key "rd/config" as JSON:
+ * {
+ *   "defaultProfile": "Desktop",
+ *   "profiles": [ { "name": "Desktop", "bitrateKbps": 50000, "codec": "auto|h264|hevc|av1",
+ *                   "hdr": false, "localCursor": true, "windowMode": "fullscreen|borderless|windowed",
+ *                   "monitors": [ { "width": 2560, "height": 1440, "fps": 144, "port": 47989, "clientDisplay": 0 },
+ *                                 { "width": 1920, "height": 1080, "fps": 60,  "port": 48089, "clientDisplay": 1 } ] } ],
+ *   "rules": [ { "name": "Phone hotspot", "match": "any|ethernet|wifi|cellular|tethered",
+ *                "ssids": ["iPhone*", "Pixel*"], "profile": "", "bitrateKbps": 10000, "maxFps": 60,
+ *                "maxHeight": 1080, "codec": "hevc" } ]
+ * }
+ * Rules are checked top to bottom; the first match wins.
+ */
+class RdProfiles : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(QVariantList profiles READ profiles WRITE setProfiles NOTIFY changed)
+    Q_PROPERTY(QVariantList rules READ rules WRITE setRules NOTIFY changed)
+    Q_PROPERTY(QString defaultProfile READ defaultProfile WRITE setDefaultProfile NOTIFY changed)
+    Q_PROPERTY(QString sessionProfile READ sessionProfile WRITE setSessionProfile NOTIFY changed)
+    Q_PROPERTY(QStringList profileNames READ profileNames NOTIFY changed)
+
+public:
+    static RdProfiles* get();
+
+    QVariantList profiles() const { return m_Profiles; }
+    void setProfiles(const QVariantList& p);
+    QVariantList rules() const { return m_Rules; }
+    void setRules(const QVariantList& r);
+    QString defaultProfile() const { return m_DefaultProfile; }
+    void setDefaultProfile(const QString& n);
+    QString sessionProfile() const { return m_SessionProfile; }
+    void setSessionProfile(const QString& n);
+    QStringList profileNames() const;
+
+    Q_INVOKABLE void save();
+    Q_INVOKABLE QVariantMap newProfile(const QString& name) const;
+    Q_INVOKABLE QVariantMap newRule(const QString& name) const;
+    // Human-readable description of the current network and the rule that matches it.
+    Q_INVOKABLE QString describeNetwork();
+
+    // CLI (secondary monitor processes): --rd-profile NAME --rd-monitor N
+    static void setCliSelection(const QString& profile, int monitorIndex);
+    static int cliMonitorIndex();
+
+    // Returns preferences for a new session. GUI sessions (cliPrefs == nullptr) get a
+    // detached copy of the saved settings with the profile + network rule applied.
+    StreamingPreferences* prepare(StreamingPreferences* cliPrefs, QObject* parent);
+
+    // Effective (resolved) values for the session that prepare() last configured.
+    bool localCursorEnabled() const { return m_ActiveLocalCursor; }
+    int clientDisplayIndex() const { return m_ActiveClientDisplay; }
+
+    // Starts one extra Moonlight process per extra monitor of the active profile.
+    void launchSecondaryMonitors(NvComputer* computer, const QString& appName);
+    void stopSecondaryMonitors();
+
+    static RdNetworkInfo detectNetwork();
+
+signals:
+    void changed();
+
+private:
+    explicit RdProfiles(QObject* parent = nullptr);
+    void load();
+    QVariantMap findProfile(const QString& name) const;
+    QVariantMap matchRule(const RdNetworkInfo& net) const;
+
+    QVariantList m_Profiles;
+    QVariantList m_Rules;
+    QString m_DefaultProfile;
+    QString m_SessionProfile;
+
+    QVariantMap m_ActiveProfile;
+    bool m_ActiveLocalCursor = true;
+    int m_ActiveClientDisplay = -1;
+    QList<QPointer<QProcess>> m_Secondaries;
+
+    static QString s_CliProfile;
+    static int s_CliMonitor;
+};
