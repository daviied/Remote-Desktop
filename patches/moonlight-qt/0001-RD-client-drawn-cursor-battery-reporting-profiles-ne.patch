diff --git a/app/gui/RdProfilesView.qml b/app/gui/RdProfilesView.qml
new file mode 100644
index 0000000..891a40c
--- /dev/null
+++ b/app/gui/RdProfilesView.qml
@@ -0,0 +1,209 @@
+// RD extension: connection profiles + network rules editor.
+import QtQuick 2.9
+import QtQuick.Controls 2.2
+import QtQuick.Layouts 1.2
+
+import RdProfiles 1.0
+
+Flickable {
+    id: page
+    objectName: qsTr("Profiles & Network Rules")
+
+    property var profiles: []
+    property var rules: []
+    property int sel: 0
+    property string defaultName: ""
+    property string netText: ""
+
+    readonly property var codecs: ["auto", "h264", "hevc", "av1"]
+    readonly property var windowModes: ["fullscreen", "borderless", "windowed"]
+    readonly property var matches: ["any", "ethernet", "wifi", "tethered", "cellular"]
+
+    contentWidth: width
+    contentHeight: column.implicitHeight + 40
+    boundsBehavior: Flickable.OvershootBounds
+    ScrollBar.vertical: ScrollBar {}
+
+    function reload() {
+        profiles = JSON.parse(JSON.stringify(RdProfiles.profiles))
+        rules = JSON.parse(JSON.stringify(RdProfiles.rules))
+        defaultName = RdProfiles.defaultProfile
+        sel = Math.max(0, Math.min(sel, profiles.length - 1))
+        netText = RdProfiles.describeNetwork()
+    }
+    function names() { return profiles.map(function(p) { return p.name }) }
+    function refreshProfiles() { profiles = profiles.slice() }
+    function refreshRules() { rules = rules.slice() }
+    function cur() { return profiles.length > 0 ? profiles[sel] : null }
+
+    function setMonitorCount(n) {
+        var p = cur()
+        while (p.monitors.length < n) {
+            var i = p.monitors.length
+            var last = p.monitors[i - 1]
+            p.monitors.push({ width: last.width, height: last.height, fps: last.fps,
+                              port: 47989 + 100 * i, clientDisplay: i })
+        }
+        p.monitors.length = n
+        refreshProfiles()
+    }
+
+    function saveAll() {
+        RdProfiles.profiles = profiles
+        RdProfiles.rules = rules
+        RdProfiles.defaultProfile = defaultName
+        RdProfiles.save()
+        reload()
+    }
+
+    Component.onCompleted: reload()
+
+    ColumnLayout {
+        id: column
+        x: 20; y: 20
+        width: page.width - 40
+        spacing: 10
+
+        // ---------------- Profiles ----------------
+        Label { text: qsTr("Connection profiles"); font.pointSize: 14; font.bold: true }
+        Label {
+            Layout.fillWidth: true; wrapMode: Text.Wrap; font.pointSize: 10
+            text: qsTr("The default profile is used on this device. Pick another one for a single connection from the toolbar. Each extra monitor streams from its own host display (host port 47989 + 100 per monitor).")
+        }
+
+        RowLayout {
+            ComboBox {
+                id: profileCombo
+                Layout.preferredWidth: 260
+                model: page.names()
+                currentIndex: page.sel
+                onActivated: page.sel = index
+            }
+            Button { text: qsTr("Add"); onClicked: { profiles.push(RdProfiles.newProfile(qsTr("Profile %1").arg(profiles.length + 1))); sel = profiles.length - 1; refreshProfiles() } }
+            Button { text: qsTr("Delete"); enabled: profiles.length > 1; onClicked: { profiles.splice(sel, 1); sel = 0; refreshProfiles() } }
+            Button {
+                text: cur() && cur().name === defaultName ? qsTr("Default on this device ✓") : qsTr("Make default on this device")
+                onClicked: defaultName = cur().name
+            }
+        }
+
+        GridLayout {
+            visible: cur() !== null
+            columns: 2
+            columnSpacing: 12
+
+            Label { text: qsTr("Name") }
+            TextField { Layout.preferredWidth: 260; text: cur() ? cur().name : ""
+                onEditingFinished: { var old = cur().name; cur().name = text; if (defaultName === old) defaultName = text; refreshProfiles() } }
+
+            Label { text: qsTr("Bitrate (Mbps, 0 = auto)") }
+            SpinBox { from: 0; to: 500; editable: true; value: cur() ? Math.round(cur().bitrateKbps / 1000) : 0
+                onValueModified: cur().bitrateKbps = value * 1000 }
+
+            Label { text: qsTr("Codec") }
+            ComboBox { model: codecs; currentIndex: cur() ? Math.max(0, codecs.indexOf(cur().codec)) : 0
+                onActivated: cur().codec = codecs[index] }
+
+            Label { text: qsTr("Window mode") }
+            ComboBox { model: windowModes; currentIndex: cur() ? Math.max(0, windowModes.indexOf(cur().windowMode)) : 0
+                onActivated: cur().windowMode = windowModes[index] }
+
+            Label { text: qsTr("HDR") }
+            CheckBox { checked: cur() ? cur().hdr : false; onToggled: cur().hdr = checked }
+
+            Label { text: qsTr("Client-drawn cursor") }
+            CheckBox { checked: cur() ? cur().localCursor !== false : true; onToggled: cur().localCursor = checked }
+
+            Label { text: qsTr("Monitors") }
+            SpinBox { from: 1; to: 3; value: cur() ? cur().monitors.length : 1; onValueModified: setMonitorCount(value) }
+        }
+
+        Repeater {
+            model: cur() ? cur().monitors : []
+            delegate: GroupBox {
+                Layout.fillWidth: true
+                title: qsTr("Monitor %1 (sets the host display resolution)").arg(index + 1)
+                property var mon: modelData
+                property int mi: index
+                GridLayout {
+                    columns: 6
+                    Label { text: qsTr("Width") }
+                    SpinBox { from: 640; to: 7680; editable: true; stepSize: 2; value: mon.width; onValueModified: cur().monitors[mi].width = value }
+                    Label { text: qsTr("Height") }
+                    SpinBox { from: 360; to: 4320; editable: true; stepSize: 2; value: mon.height; onValueModified: cur().monitors[mi].height = value }
+                    Label { text: qsTr("FPS") }
+                    SpinBox { from: 10; to: 480; editable: true; value: mon.fps; onValueModified: cur().monitors[mi].fps = value }
+                    Label { text: qsTr("Host port") }
+                    SpinBox { from: 1024; to: 65000; editable: true; value: mon.port || (47989 + 100 * index)
+                        textFromValue: function(v) { return "" + v }; onValueModified: cur().monitors[mi].port = value }
+                    Label { text: qsTr("Client screen #") }
+                    SpinBox { from: 0; to: 8; value: mon.clientDisplay !== undefined ? mon.clientDisplay : index
+                        onValueModified: cur().monitors[mi].clientDisplay = value }
+                }
+            }
+        }
+
+        // ---------------- Network rules ----------------
+        Label { text: qsTr("Network rules"); font.pointSize: 14; font.bold: true; Layout.topMargin: 20 }
+        Label {
+            Layout.fillWidth: true; wrapMode: Text.Wrap; font.pointSize: 10
+            text: qsTr("Checked top to bottom when you connect; the first match wins. A rule can switch to another profile and/or cap bitrate, FPS and height. SSIDs accept wildcards (iPhone*). 'tethered' = metered, cellular or Bluetooth link, or a listed hotspot SSID. 0 / empty = no change.")
+        }
+        RowLayout {
+            Label { text: netText; font.italic: true }
+            Button { text: qsTr("Refresh"); onClicked: netText = RdProfiles.describeNetwork() }
+        }
+
+        Repeater {
+            model: rules
+            delegate: GroupBox {
+                Layout.fillWidth: true
+                property var rule: modelData
+                property int ri: index
+                title: (ri + 1) + ". " + rule.name
+                GridLayout {
+                    columns: 4
+                    Label { text: qsTr("Name") }
+                    TextField { text: rule.name; onEditingFinished: { rules[ri].name = text; refreshRules() } }
+                    Label { text: qsTr("Connection") }
+                    ComboBox { model: matches; currentIndex: Math.max(0, matches.indexOf(rule.match)); onActivated: rules[ri].match = matches[index] }
+
+                    Label { text: qsTr("SSIDs (comma separated)") }
+                    TextField { Layout.preferredWidth: 220; text: (rule.ssids || []).join(", ")
+                        onEditingFinished: rules[ri].ssids = text.split(",").map(function(s) { return s.trim() }).filter(function(s) { return s.length > 0 }) }
+                    Label { text: qsTr("Use profile") }
+                    ComboBox { model: [qsTr("(keep)")].concat(page.names())
+                        currentIndex: rule.profile ? Math.max(0, page.names().indexOf(rule.profile) + 1) : 0
+                        onActivated: rules[ri].profile = index === 0 ? "" : page.names()[index - 1] }
+
+                    Label { text: qsTr("Bitrate (Mbps)") }
+                    SpinBox { from: 0; to: 500; editable: true; value: Math.round((rule.bitrateKbps || 0) / 1000); onValueModified: rules[ri].bitrateKbps = value * 1000 }
+                    Label { text: qsTr("Max FPS") }
+                    SpinBox { from: 0; to: 480; editable: true; value: rule.maxFps || 0; onValueModified: rules[ri].maxFps = value }
+
+                    Label { text: qsTr("Max height") }
+                    SpinBox { from: 0; to: 4320; editable: true; value: rule.maxHeight || 0; onValueModified: rules[ri].maxHeight = value }
+                    Label { text: qsTr("Codec") }
+                    ComboBox { model: [""].concat(codecs); currentIndex: Math.max(0, [""].concat(codecs).indexOf(rule.codec || "")); onActivated: rules[ri].codec = [""].concat(codecs)[index] }
+
+                    RowLayout {
+                        Layout.columnSpan: 4
+                        Button { text: "▲"; enabled: ri > 0; onClicked: { var r = rules.splice(ri, 1)[0]; rules.splice(ri - 1, 0, r); refreshRules() } }
+                        Button { text: "▼"; enabled: ri < rules.length - 1; onClicked: { var r = rules.splice(ri, 1)[0]; rules.splice(ri + 1, 0, r); refreshRules() } }
+                        Button { text: qsTr("Delete"); onClicked: { rules.splice(ri, 1); refreshRules() } }
+                    }
+                }
+            }
+        }
+
+        RowLayout {
+            Button { text: qsTr("Add rule"); onClicked: { rules.push(RdProfiles.newRule(qsTr("Rule %1").arg(rules.length + 1))); refreshRules() } }
+        }
+
+        RowLayout {
+            Layout.topMargin: 20
+            Button { text: qsTr("Save"); highlighted: true; onClicked: saveAll() }
+            Button { text: qsTr("Discard changes"); onClicked: reload() }
+        }
+    }
+}
