diff --git a/app/rd/rdprofiles.cpp b/app/rd/rdprofiles.cpp
index 7486e29..86531aa 100644
--- a/app/rd/rdprofiles.cpp
+++ b/app/rd/rdprofiles.cpp
@@ -9,6 +9,11 @@
 #include <QRegularExpression>
 #include <QSettings>
 #include <QSysInfo>
+#include <QEventLoop>
+#include <QNetworkAccessManager>
+#include <QNetworkReply>
+#include <QNetworkRequest>
+#include <QTimer>
 
 #if QT_VERSION >= QT_VERSION_CHECK(6, 3, 0)
 #include <QNetworkInformation>
@@ -39,6 +44,8 @@ void RdProfiles::load()
     m_Profiles = root.value("profiles").toList();
     m_Rules = root.value("rules").toList();
     m_DefaultProfile = root.value("defaultProfile").toString();
+    m_PowerUrl = root.value("powerUrl").toString();
+    m_PowerToken = root.value("powerToken").toString();
 
     if (m_Profiles.isEmpty()) {
         // First run: one profile matching a single native-resolution monitor.
@@ -53,6 +60,8 @@ void RdProfiles::save()
     root["profiles"] = m_Profiles;
     root["rules"] = m_Rules;
     root["defaultProfile"] = m_DefaultProfile;
+    root["powerUrl"] = m_PowerUrl;
+    root["powerToken"] = m_PowerToken;
     QSettings settings;
     settings.setValue(RD_SETTINGS_KEY, QJsonDocument::fromVariant(root).toJson(QJsonDocument::Compact));
 }
@@ -115,6 +124,35 @@ QVariantMap RdProfiles::findProfile(const QString& name) const
     return m_Profiles.isEmpty() ? QVariantMap() : m_Profiles.first().toMap();
 }
 
+QString RdProfiles::requestPowerOn()
+{
+    if (m_PowerUrl.isEmpty() || m_PowerToken.isEmpty()) {
+        return QString();
+    }
+    QUrl url(m_PowerUrl + (m_PowerUrl.endsWith('/') ? "power/wake" : "/power/wake"));
+    if (url.scheme() != "https" && url.host() != "localhost") {
+        return tr("Power server URL must use https");
+    }
+
+    QNetworkAccessManager nam;
+    QNetworkRequest req(url);
+    req.setRawHeader("Authorization", "Bearer " + m_PowerToken.toUtf8());
+    req.setHeader(QNetworkRequest::ContentTypeHeader, "application/json");
+    QNetworkReply* reply = nam.post(req, QByteArray("{}"));
+
+    QEventLoop loop;
+    QTimer::singleShot(30000, &loop, &QEventLoop::quit);
+    QObject::connect(reply, &QNetworkReply::finished, &loop, &QEventLoop::quit);
+    loop.exec();
+
+    QString result = reply->isFinished() && reply->error() == QNetworkReply::NoError
+            ? QString::fromUtf8(reply->readAll())
+            : tr("Power server error: %1").arg(reply->errorString());
+    reply->deleteLater();
+    qInfo() << "RD power on:" << result;
+    return result;
+}
+
 void RdProfiles::setCliSelection(const QString& profile, int monitorIndex)
 {
     s_CliProfile = profile;
