# nginx site for the coordinator. TLS is required (clients refuse plain HTTP).
# Brute-force protection for the power API
limit_req_zone $binary_remote_addr zone=rdpower:1m rate=10r/m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    http2 off;   # control + relay protocols need HTTP/1.1 Upgrade
    server_name rd.example.com;

    ssl_certificate     /etc/letsencrypt/live/rd.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rd.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    # headscale admin REST API: never public (rd-power reaches it inside Docker)
    location /api/ {
        return 404;
    }

    # Smart-outlet power control (rd-power)
    location /power/ {
        limit_req zone=rdpower burst=10 nodelay;
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }

    # Tailscale mode only: headscale coordinator + relay. WireGuard mode: replace this block with
    #   location / { return 404; }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect http:// https://;
        proxy_buffering off;
        proxy_read_timeout 1d;
        add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
    }
}
